{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": [
      "node",
      "vscode"
    ]
  },
  "include": [
    "extensionCache.js",
    "extensionDemo.js",
    "extensionUtils.js",
    "test/typecheck/**/*.js"
  ],
  "exclude": [
    ".vscode-test",
    "node_modules",
    "*.vsix"
  ]
}
